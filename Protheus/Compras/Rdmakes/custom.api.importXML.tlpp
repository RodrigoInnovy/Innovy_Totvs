// ====== Lista todas as Condições de Pagamento da SE4 ======
	@Get( '/api/nfe/condicoes' )
User Function listCondicoes()

	Local jResponse  := JsonObject():New()  As Json
	Local jCond      := NIL                 As Json

	Local aCondicoes := {}                  As Array

	DBSelectArea( 'SE4' )
	SE4->( DBSetOrder( 1 ) )
	SE4->( DBGoTop() )

	While SE4->( !EoF() )

		IF !SE4->( Deleted() ) .AND. SE4->E4_FILIAL == FWxFilial( 'SE4' )

			jCond := JsonObject():New()
			jCond[ 'cod'    ] := EncodeUTF8( AllTrim( SE4->E4_CODIGO ) )
			jCond[ 'descri' ] := EncodeUTF8( AllTrim( SE4->E4_DESCRI ) )
			jCond[ 'tipo'   ] := EncodeUTF8( AllTrim( SE4->E4_TIPO   ) )

			aAdd( aCondicoes, jCond )

		EndIF

		SE4->( DBSkip() )

	EndDo

	IF Len( aCondicoes ) > 0
		jResponse[ 'success' ] := .T.
		jResponse[ 'message' ] := 'Condições encontradas'
		jResponse[ 'total'   ] := Len( aCondicoes )
		jResponse[ 'data'    ] := aCondicoes
	Else
		jResponse[ 'success' ] := .F.
		jResponse[ 'message' ] := 'Nenhuma condição encontrada'
	EndIF

	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Origin',  '*'                           )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Methods', 'GET, POST, OPTIONS'          )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Headers', 'Content-Type, Authorization' )
	oRest:setKeyHeaderResponse( 'Content-Type', 'application/json; charset=utf-8'             )
	oRest:SetResponse( jResponse:ToJson()                                                     )

Return( .T. )

// ====== Busca Condição de Pagamento na SE4 por Código ======
	@Get( '/api/nfe/condicao' )
User Function buscaCondicao()

	Local jResponse := JsonObject():New()  As Json
	Local jCond     := JsonObject():New()  As Json

	Local cCod      := ''                  As Character

	cCod := AllTrim( oRest:getQueryParam( 'cod' ) )

	DBSelectArea( 'SE4' )
	SE4->( DBSetOrder( 1 ) )

	IF SE4->( MsSeek( xFilial( 'SE4' ) + cCod ) )

		jCond[ 'cod'    ] := EncodeUTF8( AllTrim( SE4->E4_CODIGO ) )
		jCond[ 'descri' ] := EncodeUTF8( AllTrim( SE4->E4_DESCRI ) )
		jCond[ 'tipo'   ] := EncodeUTF8( AllTrim( SE4->E4_TIPO   ) )

		jResponse[ 'success' ] := .T.
		jResponse[ 'message' ] := 'Condição encontrada'
		jResponse[ 'data'    ] := jCond

	Else

		jResponse[ 'success' ] := .F.
		jResponse[ 'message' ] := 'Condição de pagamento não encontrada na SE4'

	EndIF

	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Origin',  '*'                           )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Methods', 'GET, POST, OPTIONS'          )
	oRest:setKeyHeaderResponse( 'Access-Control-Allow-Headers', 'Content-Type, Authorization' )
	oRest:setKeyHeaderResponse( 'Content-Type', 'application/json; charset=utf-8'             )
	oRest:SetResponse( jResponse:ToJson()                                                     )

Return( .T. )
